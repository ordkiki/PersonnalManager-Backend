{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Cors": {
    "Policy": "PersonalManager",
    "Url": "http://localhost:3000"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=personnal_manager;Username=postgres;Password=8989"
  },

  "Files": {
    "BasePath": "wwwroot/uploads",
    "Paths": {
      "Avatar": {
        "employees": "employees"
      }
    }
  },

  "ValidImageExtensions": [
    ".jpg",
    ".jfif",
    ".png",
    ".jpeg",
    ".svg",
    "gif",
    ".tif",
    ".webp",
    ".heic",
    ".heif",
    ".avif",
    ".bmp"
  ],
  "MaxSize": 5,
  "AllowedHosts": "*"
}
